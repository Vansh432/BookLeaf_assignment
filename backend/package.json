{
  "name": "backend",
  "version": "1.0.0",
  "description": "it is AI-power admin panel",
  "license": "ISC",
  "author": "vansh",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/database/seeders/seed.js",
    "seed:fresh": "node src/database/seeders/seed.js --fresh",
    "db:indexes": "node src/database/indexes/sync.js",
    "kb:ingest": "node src/database/seeders/knowledge.js",
    "test": "node --test --test-concurrency=1 --import ./src/tests/setup.js \"src/tests/**/*.test.js\"",
    "eval": "node src/tests/eval/run.js",
    "eval:live": "node src/tests/eval/run.js --live"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
