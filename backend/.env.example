NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/bookleaf
# Atlas (required for Vector Search): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookleaf?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf
# Optional: set if Atlas fails with "querySrv ECONNREFUSED" (local DNS refuses SRV lookups)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Vector size of the embedding model (set once a provider is chosen), then run `npm run db:indexes`
# gemini-embedding-2 supports 128-3072 (768, 1536, 3072 recommended); 768 keeps storage small
EMBEDDING_DIMENSIONS=768
# Server-side only; never expose to the frontend. Leave empty to run without AI (rules/keyword fallbacks).
GEMINI_API_KEY=
# Measured on 2026-10-25: gemini-3.5-flash-lite answered triage calls in 2-3s; gemini-3.8-flash took
# 20-100s and hit quota limits, and gemini-3.6-flash returned 503 (high demand).
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
# Optional model for drafted replies (defaults to GEMINI_GENERATION_MODEL); add it to AI_PRICING if set
# GEMINI_DRAFT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Per attempt; also sent to Gemini as its server-side deadline. gemini-3.8-flash has been measured
# at 4-23s for a tiny prompt, so values near 20s cause 504 DEADLINE_EXCEEDED.
AI_REQUEST_TIMEOUT_MS=60000
# Attempts per AI call (only timeouts, 429 and 5xx are retried; Retry-After is honoured)
AI_MAX_ATTEMPTS=3
# USD per 1M tokens per model; required for every configured model when GEMINI_API_KEY is set.
# Costs computed from these are estimates, not invoices; update when provider prices change.
AI_PRICING={"gemini-3.5-flash-lite":{"input":0.30,"output":2.50,"cachedInput":0.03},"gemini-embedding-2":{"input":0.20}}
# Hard spend caps (estimated USD); AI calls are refused, and manual/rule fallbacks used, once reached
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10
AI_MAX_CALLS_PER_TICKET=20
# Requests per minute per model, kept below the provider quota so bursts queue instead of failing.
# Gemini free tier: 15/min for gemini-3.5-flash-lite. Raise it on a paid tier; omit a model to leave it unthrottled.
AI_REQUESTS_PER_MINUTE={"gemini-3.5-flash-lite":12}
# Comma-separated list of frontend origins allowed by CORS
CLIENT_URLS=http://localhost:5173
LOG_LEVEL=debug
# Demo login passwords applied by `npm run seed`
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-for-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# lax for local dev; use none (+ COOKIE_SECURE=true) when frontends and API are on different domains
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
